<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version><Deterministic>true</Deterministic>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).tools\nuget</RestorePackagesPath>
  </PropertyGroup>
</Project>
